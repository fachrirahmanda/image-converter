{
  "name": "image-converter",
  "version": "1.0.0",
  "description": "In-browser image converter, compressor and resizer",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy --branch main"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.5.0",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.2",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "private": true
}
